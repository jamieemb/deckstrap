[Desktop Entry]
Type=Application
Version=1.0
Name=deckstrap installer
Comment=Set up this Steam Deck from a deckstrap profile
Icon=steamdeck-gaming-return
Terminal=false
Categories=Utility;
Exec=bash -c "if curl -fsSL -o /tmp/deckstrap.sh https://jamieemb.github.io/deckstrap/deckstrap.sh; then konsole --noclose -e bash /tmp/deckstrap.sh; else zenity --error --width=360 --text='deckstrap: download failed. Check the internet connection and try again.'; fi"
