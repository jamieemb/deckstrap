[Desktop Entry]
Type=Application
Version=1.0
Name=deckstrap installer
Comment=Set up this Steam Deck from a deckstrap profile
Icon=steamdeck-gaming-return
Terminal=false
Categories=Utility;
Exec=bash -c "curl -fsSL https://jamieemb.github.io/deckstrap/launch.sh | bash -s -- || zenity --error --width=400 --text='deckstrap: the installer could not be downloaded or started. Check the internet connection and try again.'"
