[Desktop Entry]
Type=Application
Version=1.0
Name=deckstrap installer (Jamie's Deck)
Comment=Set up this Steam Deck exactly like Jamie's: all plugins, themes and settings
Icon=steamdeck-gaming-return
Terminal=false
Categories=Utility;
Exec=bash -c "curl -fsSL https://jamieemb.github.io/deckstrap/launch.sh | bash -s -- --profile-url https://jamieemb.github.io/deckstrap/profiles/jamie-deck.tar.gz || zenity --error --width=400 --text='deckstrap: the installer could not be downloaded or started. Check the internet connection and try again.'"
