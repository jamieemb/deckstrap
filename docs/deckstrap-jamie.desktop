[Desktop Entry]
Type=Application
Version=1.0
Name=deckstrap installer (Jamie's Deck)
Comment=Set up this Steam Deck exactly like Jamie's: all plugins, themes and settings
Icon=steamdeck-gaming-return
Terminal=false
Categories=Utility;
Exec=bash -c "if curl -fsSL -o /tmp/deckstrap.sh https://jamieemb.github.io/deckstrap/deckstrap.sh; then konsole --noclose -e bash /tmp/deckstrap.sh --profile-url https://jamieemb.github.io/deckstrap/profiles/jamie-deck.tar.gz; else zenity --error --width=360 --text='deckstrap: download failed. Check the internet connection and try again.'; fi"
