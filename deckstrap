#!/usr/bin/env bash
# =============================================================================
#  deckstrap - set up a Steam Deck from a profile, fresh, every time
#
#    deckstrap gui profile.json [--assets DIR]          # full-screen installer (Firefox kiosk)
#    deckstrap apply profile.json [--only a,b] [--skip a,b] [--dry-run] [--wizard] [--assets DIR]
#    deckstrap export [--from ~/homebrew] [--name NAME] [--redact] [--out profile.json]
#    deckstrap status profile.json | modules profile.json
#    deckstrap list | doctor | validate profile.json | version
#
#  Run from Desktop Mode as the normal "deck" user (never with sudo).
# =============================================================================
set -uo pipefail

DECKSTRAP_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib/core.sh
source "$DECKSTRAP_DIR/lib/core.sh"

usage() {
  sed -n '3,11p' "${BASH_SOURCE[0]}" | sed -E 's/^# ?//; s/^ {0,2}//'
  echo
  echo "Modules (enable them in the profile):"
  load_modules
  local m
  for m in "${MODULES[@]}"; do printf '  %-18s %s\n' "$m" "${MOD_DESCS[$m]}"; done
}

# ----------------------------------------------------------------------------
cmd_apply() {
  PROFILE=""; ONLY=""; SKIP=""; DRY_RUN=0; ASSETS=""; WIZARD=0
  while (($#)); do
    case "$1" in
      --only)    ONLY="$2"; shift 2 ;;
      --skip)    SKIP="$2"; shift 2 ;;
      --assets)  ASSETS="$2"; shift 2 ;;
      --dry-run) DRY_RUN=1; shift ;;
      --wizard)  WIZARD=1; shift ;;
      -h|--help) usage; exit 0 ;;
      -*)        die "unknown option: $1" ;;
      *)         PROFILE="$1"; shift ;;
    esac
  done
  [[ -n "$PROFILE" ]] || die "usage: deckstrap apply <profile.json> [options]"
  [[ -f "$PROFILE" ]] || die "profile not found: $PROFILE"
  PROFILE="$(readlink -f "$PROFILE")"
  python3 "$PROFILE_PY" validate "$PROFILE" || die "profile failed validation"
  if [[ -z "$ASSETS" ]]; then
    ASSETS="$(dirname "$PROFILE")"
    [[ -d "$ASSETS/assets" ]] && ASSETS="$ASSETS/assets"
  fi
  export PROFILE ASSETS DRY_RUN

  if (( WIZARD )); then
    load_modules
    ONLY="$(wizard_pick_modules)" || die "cancelled"
    [[ -n "$ONLY" ]] || die "no modules selected"
  fi

  LOG="$HOME/deckstrap.log"
  exec > >(tee -a "$LOG") 2>&1
  echo "============================================================"
  echo " deckstrap $DECKSTRAP_VERSION  -  $(date)"
  echo " profile: $PROFILE ($(pget name 'unnamed'))"
  echo " assets:  $ASSETS"
  echo " log:     $LOG"
  (( DRY_RUN )) && echo " DRY RUN: nothing will be changed"
  echo "============================================================"

  load_modules
  (( DRY_RUN )) || preflight

  local m
  for m in "${MODULES[@]}"; do
    if [[ -n "$ONLY" ]] && ! list_has "$ONLY" "$m"; then continue; fi
    if [[ -n "$SKIP" ]] && list_has "$SKIP" "$m"; then info "skipping $m (--skip)"; continue; fi
    if ! "mod_${m}_wanted"; then echo "${C_DIM}-- $m: not enabled in profile${C_RST}"; continue; fi
    "mod_${m}_apply"
  done

  echo
  echo "============================================================"
  if (( ${#FAILED_STEPS[@]} == 0 )); then
    ok "All steps completed (${#DONE_STEPS[@]} done, ${#SKIPPED_STEPS[@]} skipped)."
  else
    err "Steps with errors: ${FAILED_STEPS[*]}"
    echo "   See $LOG. Re-running is safe; finished steps are skipped or redone cleanly."
  fi
  load_modules
  local notes=()
  for m in "${MODULES[@]}"; do
    if "mod_${m}_wanted" && declare -F "mod_${m}_notes" >/dev/null; then
      mapfile -t -O "${#notes[@]}" notes < <("mod_${m}_notes")
    fi
  done
  if (( ${#notes[@]} )); then
    echo; echo "Next, by hand:"
    printf '  * %s\n' "${notes[@]}"
  fi
  echo "============================================================"
  (( ${#FAILED_STEPS[@]} == 0 ))
}

# Let the user tick the modules to run. zenity (ships with SteamOS) when a
# display is available, otherwise a yes/no prompt per module. Prints "a,b,c".
wizard_pick_modules() {
  local m picked=()
  if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v zenity >/dev/null; then
    local rows=()
    for m in "${MODULES[@]}"; do
      local on=FALSE; "mod_${m}_wanted" && on=TRUE
      rows+=("$on" "$m" "${MOD_DESCS[$m]}")
    done
    zenity --list --checklist --width=760 --height=520 \
      --title="deckstrap: $(pget name 'profile')" \
      --text="Tick what to set up on this Deck. Everything is installed fresh; your profile's settings are applied on top." \
      --column="Run" --column="Module" --column="What it does" --separator="," \
      --print-column=2 "${rows[@]}"
    return $?
  fi
  for m in "${MODULES[@]}"; do
    local def="n"; "mod_${m}_wanted" && def="y"
    read -r -p "$m - ${MOD_DESCS[$m]} [${def}]: " ans </dev/tty
    ans="${ans:-$def}"
    [[ "$ans" =~ ^[Yy] ]] && picked+=("$m")
  done
  local IFS=','; echo "${picked[*]}"
}

# ----------------------------------------------------------------------------
#  modules: machine-readable module list for the GUI backend (name, wanted, desc)
cmd_modules() {
  PROFILE="${1:-}"; [[ -f "$PROFILE" ]] || die "usage: deckstrap modules <profile.json>"
  PROFILE="$(readlink -f "$PROFILE")"; export PROFILE
  ASSETS="${ASSETS:-$(dirname "$PROFILE")}"; export ASSETS
  load_modules
  local m wanted
  for m in "${MODULES[@]}"; do
    wanted="no"; "mod_${m}_wanted" && wanted="yes"
    printf '%s\t%s\t%s\n' "$m" "$wanted" "${MOD_DESCS[$m]}"
  done
}

# ----------------------------------------------------------------------------
#  gui: the full-screen installer. A local python backend (lib/server.py)
#  serves ui/ and runs `deckstrap apply`; Firefox (installed from Flathub if
#  missing) shows it in kiosk mode. Falls back to the zenity/terminal wizard.
cmd_gui() {
  PROFILE=""; ASSETS=""; local dry=0
  while (($#)); do
    case "$1" in
      --assets)  ASSETS="$2"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      -h|--help) usage; exit 0 ;;
      -*)        die "unknown option: $1" ;;
      *)         PROFILE="$1"; shift ;;
    esac
  done
  [[ -n "$PROFILE" && -f "$PROFILE" ]] || die "usage: deckstrap gui <profile.json> [--assets DIR]"
  PROFILE="$(readlink -f "$PROFILE")"
  python3 "$PROFILE_PY" validate "$PROFILE" || die "profile failed validation"
  if [[ -z "$ASSETS" ]]; then
    ASSETS="$(dirname "$PROFILE")"; [[ -d "$ASSETS/assets" ]] && ASSETS="$ASSETS/assets"
  fi
  export PROFILE ASSETS

  local fallback=(apply "$PROFILE" --assets "$ASSETS" --wizard)
  (( dry )) && fallback+=(--dry-run)
  if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    warn "No display found; using the terminal wizard instead of the GUI."
    cmd_apply "${fallback[@]:1}"; return
  fi
  if ! gui_ensure_firefox; then
    warn "Could not install Firefox to show the installer; using the wizard instead."
    cmd_apply "${fallback[@]:1}"; return
  fi

  local url
  exec 3< <(python3 "$DECKSTRAP_DIR/lib/server.py" --profile "$PROFILE" --assets "$ASSETS")
  local server_pid=$!
  if ! read -r -t 30 url <&3 || [[ "$url" != URL=* ]]; then
    err "the GUI backend did not start"; kill "$server_pid" 2>/dev/null
    cmd_apply "${fallback[@]:1}"; return
  fi
  url="${url#URL=}"; (( dry )) && url+="&dry=1"
  info "installer UI at $url"

  gui_open_firefox "$url" &
  local ff_pid=$!
  # whichever ends first: the UI's Close button stops the server; Alt+F4 ends Firefox
  wait -n "$server_pid" "$ff_pid" 2>/dev/null
  if kill -0 "$server_pid" 2>/dev/null; then
    curl -fs -X POST -H "X-Deckstrap-Token: ${url##*t=}" "${url%%\?*}api/quit" >/dev/null 2>&1
    sleep 1; kill "$server_pid" 2>/dev/null
  fi
  flatpak kill org.mozilla.firefox >/dev/null 2>&1 || true
  kill "$ff_pid" 2>/dev/null; wait "$ff_pid" 2>/dev/null
  exec 3<&-
  ok "installer closed; the full log is in $HOME/deckstrap.log"
}

gui_ensure_firefox() {
  flatpak_installed org.mozilla.firefox && return 0
  info "Firefox is needed to show the installer; installing it from Flathub..."
  local log; log="$(mktemp)"
  (
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
      || flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    flatpak install -y --noninteractive flathub org.mozilla.firefox \
      || flatpak install -y --noninteractive --user flathub org.mozilla.firefox
  ) > "$log" 2>&1 &
  local pid=$!
  if command -v zenity >/dev/null; then
    ( while kill -0 "$pid" 2>/dev/null; do echo "# Preparing the installer: downloading Firefox..."; sleep 2; done ) \
      | zenity --progress --pulsate --auto-close --no-cancel --width=460 --title="deckstrap" \
          --text="Preparing the installer: downloading Firefox..." >/dev/null 2>&1
  fi
  wait "$pid"; local rc=$?
  (( rc == 0 )) || { tail -n 5 "$log" >&2; }
  rm -f "$log"
  flatpak_installed org.mozilla.firefox
}

gui_open_firefox() {   # gui_open_firefox <url>: kiosk window with a private, pre-configured profile
  local prof="$HOME/.var/app/org.mozilla.firefox/deckstrap-ui"
  mkdir -p "$prof"
  cat > "$prof/user.js" <<'PREFS'
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("datareporting.policy.firstRunURL", "");
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("app.update.enabled", false);
PREFS
  flatpak run org.mozilla.firefox --kiosk --new-instance --no-remote --profile "$prof" "$1" >/dev/null 2>&1
}

# ----------------------------------------------------------------------------
cmd_status() {
  PROFILE="${1:-}"; [[ -f "$PROFILE" ]] || die "usage: deckstrap status <profile.json>"
  PROFILE="$(readlink -f "$PROFILE")"; export PROFILE
  ASSETS="$(dirname "$PROFILE")"; export ASSETS
  load_modules
  local m
  printf '%-18s %-10s %s\n' "MODULE" "WANTED" "STATUS"
  for m in "${MODULES[@]}"; do
    local wanted="no" status="-"
    "mod_${m}_wanted" && wanted="yes"
    if declare -F "mod_${m}_check" >/dev/null; then
      status="$("mod_${m}_check" 2>/dev/null)" || status="${status:-missing}"
    fi
    printf '%-18s %-10s %s\n' "$m" "$wanted" "$status"
  done
}

# ----------------------------------------------------------------------------
cmd_doctor() {
  local rc=0
  chk() { if "$@" >/dev/null 2>&1; then ok "$*"; else err "$*"; rc=1; fi; }
  grep -qi steamos /etc/os-release 2>/dev/null && ok "SteamOS detected" || warn "not SteamOS ($(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}"))"
  chk command -v python3
  chk command -v curl
  chk command -v flatpak
  chk command -v rsync
  chk command -v systemctl
  if [[ $EUID -eq 0 ]]; then err "running as root; run as the deck user"; rc=1; else ok "not root"; fi
  if passwd -S "$USER" 2>/dev/null | awk '{print $2}' | grep -q '^NP'; then warn "no sudo password set yet (apply will prompt)"; else ok "sudo password set"; fi
  curl -fsSL --max-time 10 https://github.com >/dev/null 2>&1 && ok "internet reachable" || { err "no internet"; rc=1; }
  return $rc
}

# ----------------------------------------------------------------------------
cmd="${1:-help}"; shift || true
case "$cmd" in
  apply)    cmd_apply "$@" ;;
  gui)      cmd_gui "$@" ;;
  modules)  cmd_modules "$@" ;;
  export)   python3 "$PROFILE_PY" export "$@" ;;
  validate) python3 "$PROFILE_PY" validate "$@" && ok "profile is valid" ;;
  status)   cmd_status "$@" ;;
  list)     usage ;;
  doctor)   cmd_doctor ;;
  version)  echo "deckstrap $DECKSTRAP_VERSION" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $cmd (try: deckstrap help)" ;;
esac
